# Environment Configuration for NetTrace V1.0 Enterprise Backend

# App Environment
ENVIRONMENT=development
PROJECT_NAME="NetTrace V1.0 Enterprise Backend"
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database Configuration (Supabase PostgreSQL / Local PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nettrace_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nettrace_db

# Supabase Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage Configuration
STORAGE_BUCKET=nettrace-evidence
UPLOAD_DIRECTORY=./uploads
MAX_UPLOAD_SIZE=524288000  # 500 MB in bytes

# AI Analytics
GOOGLE_GEMINI_API_KEY=your-google-gemini-api-key

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@nettrace.enterprise
SMTP_PASSWORD=your-smtp-password
